rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Logos / product photos uploaded from Creative Studio
    match /users/{uid}/studio/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    // AI artwork: only the Cloud Function writes
    match /users/{uid}/artwork/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
